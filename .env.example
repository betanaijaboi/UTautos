# Supabase (real project, already provisioned)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME_anon_key
# Service role key: fetch from Supabase dashboard -> Project Settings -> API and paste here.
# NEVER exposed to the client — only used in app/api/webhooks/* route handlers.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_service_role_key

# Stripe (placeholders — app runs in dev-mode payment simulation until these are real)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_PAYSTACK_REPLACE_ME
PAYSTACK_SECRET_KEY=sk_test_PAYSTACK_REPLACE_ME

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=PAYPAL_CLIENT_ID_REPLACE_ME
PAYPAL_CLIENT_SECRET=PAYPAL_SECRET_REPLACE_ME

# Google Maps (Places Autocomplete + Directions)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=GOOGLE_MAPS_REPLACE_ME

# Business contact info used in checkout / bank transfer / express CTA
NEXT_PUBLIC_BUSINESS_PHONE=+1-555-0100
NEXT_PUBLIC_BUSINESS_NAME=UT Autos Detailing
